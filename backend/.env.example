# RippleIQ Backend Environment Variables
APP_NAME=RippleIQ
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=replace-with-a-private-random-key-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection. For Neon, use its pooled or direct URI with sslmode=require.
# Percent-encode reserved characters in the username/password. Keep the real URI in
# backend/.env or the deployment secret manager; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Simulation Engine and provider failover. Supply only newly rotated credentials
# through backend/.env or your deployment secret manager; never commit them.
ANALYZER_BACKEND=multi_provider
LLM_PRIMARY_BASE_URL=https://gemini-proxy-nu-six.vercel.app/api/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gpt-5.5
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_FAILOVER_ENABLED=true
LLM_DEGRADED_MODE_ENABLED=false
LLM_MAX_OUTPUT_TOKENS=

# OCR is optional at runtime; install backend/requirements-ocr.txt for
# digital PDF extraction and Tesseract OCR. Marker runs as a separate worker.
OCR_ENABLED=true
OCR_MAX_FILE_SIZE_BYTES=10485760
OCR_MAX_PAGES=100
OCR_MAX_PROCESSING_SECONDS=30
OCR_BACKEND=tesseract

# Optional user-initiated voice transcription. Uses Gemini 3.5 Transcribe and
# the configured Gemini keys. Audio is not stored by RippleIQ.
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
VOICE_TRANSCRIPTION_MAX_BYTES=8388608

# Database-backed sensitive-route rate limits. Counts are fixed-window maxima.
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_ACCOUNT_IP_MAX=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_ANALYSIS_USER_MAX=5
RATE_LIMIT_ANALYSIS_IP_MAX=15
RATE_LIMIT_ANALYSIS_WINDOW_SECONDS=3600
RATE_LIMIT_RETRY_USER_MAX=3
RATE_LIMIT_RETRY_IP_MAX=10
RATE_LIMIT_RETRY_WINDOW_SECONDS=3600
RATE_LIMIT_DOCUMENT_USER_MAX=10
RATE_LIMIT_DOCUMENT_IP_MAX=30
RATE_LIMIT_DOCUMENT_WINDOW_SECONDS=3600
RATE_LIMIT_VOICE_USER_MAX=20
RATE_LIMIT_VOICE_IP_MAX=60
RATE_LIMIT_VOICE_WINDOW_SECONDS=3600

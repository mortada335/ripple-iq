# RippleIQ Backend Environment Variables
APP_NAME=RippleIQ
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=replace-with-a-private-random-key-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection. For Neon, use its pooled or direct URI with sslmode=require.
# Percent-encode reserved characters in the username/password. Keep the real URI in
# backend/.env or the deployment secret manager; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Simulation Engine and provider failover. Supply only newly rotated credentials
# through backend/.env or your deployment secret manager; never commit them.
ANALYZER_BACKEND=multi_provider
LLM_PRIMARY_BASE_URL=https://gemini-proxy-nu-six.vercel.app/api/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gpt-5.5
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_FAILOVER_ENABLED=true
LLM_DEGRADED_MODE_ENABLED=false
LLM_MAX_OUTPUT_TOKENS=

# OCR is optional at runtime; install backend/requirements-ocr.txt for
# digital PDF extraction and Tesseract OCR. Marker runs as a separate worker.
OCR_ENABLED=true
OCR_MAX_FILE_SIZE_BYTES=10485760
OCR_MAX_PAGES=100
OCR_MAX_PROCESSING_SECONDS=30
OCR_BACKEND=tesseract

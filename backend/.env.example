# RippleIQ Backend Environment Variables
APP_NAME=RippleIQ
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection URL
# SQLite default for zero-config local run:
DATABASE_URL=sqlite:///./ripple_iq.db
# PostgreSQL for production/docker:
# DATABASE_URL=postgresql://rippleiq_user:rippleiq_password@localhost:5432/rippleiq_db

# Simulation Engine
ANALYZER_BACKEND=mock_deterministic

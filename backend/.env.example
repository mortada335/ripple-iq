# RippleIQ Backend Environment Variables
APP_NAME=RippleIQ
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection (set credentials for your local PostgreSQL instance)
DATABASE_URL=postgresql+psycopg2://rippleiq_user:replace-me@localhost:5432/rippleiq_db

# Simulation Engine
ANALYZER_BACKEND=mock_deterministic

# Environment Variables Example for RippleIQ
# Copy this file to .env for local Docker Compose execution

# Application Configuration
APP_NAME=RippleIQ
ENVIRONMENT=development
DEBUG=True
PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=replace-with-a-private-random-key-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL for Docker, SQLite supported for quick local development)
POSTGRES_USER=rippleiq_user
POSTGRES_PASSWORD=rippleiq_password
POSTGRES_DB=rippleiq_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://rippleiq_user:rippleiq_password@localhost:5432/rippleiq_db
# For zero-config standalone local run without Docker:
# DATABASE_URL=sqlite:///./ripple_iq.db
